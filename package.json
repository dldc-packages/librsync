{
  "name": "@dldc/librsync",
  "version": "2.0.3",
  "description": "A WASM build of the fast_rsync crate implementing the rsync algorithm",
  "keywords": [
    "diff",
    "librsync",
    "patch",
    "rsync",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dldc-packages/librsync.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "vp test run",
    "format": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "pack": "vp pack",
    "build:wasm": "node build.ts",
    "release:check": "vp check && vp test run && vp pack",
    "release": "bumpp --execute \"npm run release:check\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
